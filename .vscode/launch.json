{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Консольная версия",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Сайт Django",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": ["runserver", "--noreload"],
            "django": true,
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
